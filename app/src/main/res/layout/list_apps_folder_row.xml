<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Folder header for the app list. Deliberately mirrors list_apps_row.xml
  ~ (same margins, icon box and text size) so folders sit in the list without
  ~ introducing a second visual language.
  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_apps_folder_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="15sp">

    <ImageView
        android:id="@+id/list_apps_folder_row_icon"
        android:layout_width="40sp"
        android:layout_height="40sp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/baseline_folder_24"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/list_apps_folder_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20sp"
        android:gravity="start"
        android:text=""
        android:textSize="20sp"
        tools:text="Work"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/list_apps_folder_row_icon"
        app:layout_constraintEnd_toStartOf="@id/list_apps_folder_row_chevron"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/list_apps_folder_row_chevron"
        android:layout_width="24sp"
        android:layout_height="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/baseline_expand_more_24"
        android:importantForAccessibility="no" />

</androidx.constraintlayout.widget.ConstraintLayout>
